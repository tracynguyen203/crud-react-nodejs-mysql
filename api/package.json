{
  "name": "crud-api",
  "version": "1.0.0",
  "description": "CRUD REST API (Express + MySQL)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "devStart": "node --watch index.js",
    "test": "jest --ci --coverage"
  },
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "jest-junit": "^17.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["app.js"],
    "coverageReporters": ["lcov", "text-summary"],
    "reporters": ["default", ["jest-junit", { "outputDirectory": "reports", "outputName": "junit.xml" }]]
  }
}
